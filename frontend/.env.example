# ==============================================================================
# CockroachTalk Frontend Environment Configuration Template
# Platform: Vercel / Production / Local
# Note: ONLY public NEXT_PUBLIC_* variables belong here (no backend secrets!)
# ==============================================================================

# Backend REST API Base URL (Point this to your live Render Web Service URL without trailing slash)
# Production example: https://cockroachtalk-backend.onrender.com
# Local development: http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com

# Backend Socket.io Real-Time Server Base URL (Same as your Render Web Service URL)
# Production example: https://cockroachtalk-backend.onrender.com
# Local development: http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=https://your-backend-app.onrender.com
