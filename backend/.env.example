# ==============================================================================
# CockroachTalk Backend Environment Configuration Template
# Platform: Render / Production / Local
# ==============================================================================

# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# Port for the HTTP/WebSocket server (Render automatically sets this in production)
PORT=8000

# MongoDB Atlas Connection URI (Replace with your actual Atlas cluster credentials)
# Example: mongodb+srv://db_user:securepassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB Database Name
MONGODB_DB=cockroachtalk

# Allowed Frontend Origins (Set this to your live Vercel URL in production, without trailing slash)
# Multiple origins can be comma-separated: https://cockroachtalk.vercel.app,http://localhost:3000
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Cryptographic Secret for signing User Anonymous Session Tokens (Generate a long random string)
SESSION_SECRET=replace_with_a_long_random_secure_hex_string_32_plus_chars

# Password required to log into the Admin Dashboard (/admin)
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ==============================================================================
# Optional Third-Party Integrations
# ==============================================================================

# Metered Cloud TURN Server (Free tier from https://www.metered.ca/tools/openrelay)
# If omitted, WebRTC falls back to Google's public STUN servers
TURN_USERNAME=your_metered_turn_username
TURN_CREDENTIAL=your_metered_turn_credential

# Google Perspective API Key (Optional: for ML-powered message & name toxicity scoring)
PERSPECTIVE_API_KEY=your_perspective_api_key_here
